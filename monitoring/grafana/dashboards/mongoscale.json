        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mongoscale_error_rate_percent",
          "legendFormat": "errors %"
        }
      ]
    },
    {
      "id": 4,
